{
  "appId": "com.rajaxdx.tahadiraja",
  "appName": "تحدي رجا",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#141110"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#141110",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#141110",
      "overlaysWebView": true
    }
  }
}
